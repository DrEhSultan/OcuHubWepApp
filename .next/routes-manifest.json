{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/api/admin/analytics",
      "regex": "^/api/admin/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/analytics(?:/)?$"
    },
    {
      "page": "/api/admin/announcements",
      "regex": "^/api/admin/announcements(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/announcements(?:/)?$"
    },
    {
      "page": "/api/admin/feedbacks",
      "regex": "^/api/admin/feedbacks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/feedbacks(?:/)?$"
    },
    {
      "page": "/api/admin/login",
      "regex": "^/api/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/login(?:/)?$"
    },
    {
      "page": "/api/admin/logout",
      "regex": "^/api/admin/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/logout(?:/)?$"
    },
    {
      "page": "/api/admin/tool-usage",
      "regex": "^/api/admin/tool\\-usage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/tool\\-usage(?:/)?$"
    },
    {
      "page": "/data-deletion",
      "regex": "^/data\\-deletion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/data\\-deletion(?:/)?$"
    },
    {
      "page": "/help-faq",
      "regex": "^/help\\-faq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/help\\-faq(?:/)?$"
    },
    {
      "page": "/privacy-policy",
      "regex": "^/privacy\\-policy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy\\-policy(?:/)?$"
    },
    {
      "page": "/terms-of-service",
      "regex": "^/terms\\-of\\-service(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms\\-of\\-service(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/admin",
      "dataRouteRegex": "^/_next/data/OwM0nXbsPLuSwZoP\\-XXIH/admin\\.json$"
    },
    {
      "page": "/admin/login",
      "dataRouteRegex": "^/_next/data/OwM0nXbsPLuSwZoP\\-XXIH/admin/login\\.json$"
    }
  ],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
